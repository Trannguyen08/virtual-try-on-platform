APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Storage & Paths
DATA_DIR=./data
MODEL_DIR=./data/external/pretrained
OUTPUT_DIR=./data/outputs
DATABASE_URL=postgresql+psycopg://tryon:tryon@127.0.0.1:5432/tryon
PGADMIN_DEFAULT_EMAIL=admin@tryon.dev
PGADMIN_DEFAULT_PASSWORD=tryon-local

# Absolute path to blender.exe; leave empty to use PATH or automatic discovery.
BLENDER_PATH=

# MPFB refit: asset packs extracted by `python -m garment.mpfb.setup --download-demo`.
# Paths are relative to the repository unless absolute. Restart backend after changes.
MPFB_ASSET_ROOT=./data/external/mpfb
MPFB_GARMENT_CATALOG=./garment/mpfb/catalog.json
