GARMENT3D_PROVIDER=tripo
GARMENT3D_PRESET=balanced
GARMENT3D_POSTPROCESSOR=passthrough

# Store the real value only in the ignored root .env, never in this example.
TRIPO_API_KEY=
TRIPO_BASE_URL=https://openapi.tripo3d.ai/v3
GARMENT3D_MODEL_REVISION=v3.1-20260211

# Required only when GARMENT3D_POSTPROCESSOR=blender.
BLENDER_EXECUTABLE=blender
